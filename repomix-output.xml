    assert graph.number_of_nodes() >= 6
    assert graph.number_of_edges() >= 5
    assert any(data["name"] == "Legacy Portal" for _, data in graph.nodes(data=True))


def test_dashboard_migration_simulator_returns_roadmap_data(tmp_path):
